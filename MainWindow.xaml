<Window x:Class="RingInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:RingInspector.Input"
        xmlns:mapping="clr-namespace:RingInspector.Mapping"
        Title="Ring Inspector" Width="1320" Height="820" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Dropdown entry: a paired Bluetooth device (covers all of its input collections) -->
        <DataTemplate DataType="{x:Type input:BluetoothDeviceItem}">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="Gray" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Secondary}" Margin="8,0,0,0"
                           Text="{Binding Status, StringFormat={}Bluetooth · {0}}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="8,0,0,0" Text="{Binding InputSummary}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="8,0,0,0"
                           Text="{Binding EventCount, StringFormat={}· {0} events}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="#FF3FB950" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Dropdown entry: a single input collection (keyboard, mouse, media keys, ...) -->
        <DataTemplate DataType="{x:Type input:DeviceInfo}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding IsBluetooth, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="BT" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Secondary}" Margin="8,0,0,0" Text="{Binding Kind}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="8,0,0,0"
                           Text="{Binding EventCount, StringFormat={}· {0} events}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Ring Inspector" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                       Text="Pick your ring from the list, then press its buttons to see what it sends to Windows and what Windows does with it by default." />
        </StackPanel>

        <!-- Device picker -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Device" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="DevicePicker" MinWidth="520" HorizontalAlignment="Left"
                      SelectionChanged="DevicePicker_SelectionChanged" />
        </DockPanel>

        <!-- Last input -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Border CornerRadius="8" Padding="20" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="LAST BUTTON" />
                        <TextBlock x:Name="LastName" Text="Choose a device" FontSize="34" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LastAction" FontSize="16" Margin="0,2,0,0" />
                        <TextBlock x:Name="LastCode" FontFamily="Cascadia Mono, Consolas" FontSize="14" Margin="0,6,0,0" />
                        <TextBlock x:Name="LastDevice" Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="DEFAULT WINDOWS BEHAVIOR" />
                        <TextBlock x:Name="LastBehavior" FontSize="18" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="LastDetails" Style="{StaticResource Secondary}" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="Flash" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="3" Grid.RowSpan="2">
            <!-- ================= Live log ================= -->
            <TabItem Header="Live log">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copy log" Margin="0,0,8,0" Click="Copy_Click"
                                    ToolTip="Copy the visible rows as tab-separated text" />
                            <Button Content="Clear" Click="Clear_Click" />
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox x:Name="AppliedOnly" Content="Applied actions only" Margin="0,0,20,0"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"
                                      ToolTip="Hide releases, movement, touch bookkeeping and buttons Windows ignores — keep only inputs that make Windows do something (volume, media, scroll, swipe, tap…)" />
                            <CheckBox x:Name="ShowReleases" Content="Show releases &amp; repeats" Margin="0,0,20,0"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
                            <CheckBox x:Name="ShowMovement" Content="Record movement (mouse / touch)" />
                        </WrapPanel>
                    </DockPanel>

                    <Grid>
                        <DataGrid x:Name="EventGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                                  SelectionMode="Extended" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="100" />
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="190" />
                                <DataGridTextColumn Header="Button / input" Binding="{Binding Name}" Width="170" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="170" />
                                <DataGridTextColumn Header="Default behavior" Binding="{Binding Behavior}" Width="2*" />
                                <DataGridTextColumn Header="Collection" Binding="{Binding Device.Kind}" Width="*" />
                                <DataGridTextColumn Header="Details (raw report)" Binding="{Binding Details}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Secondary}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="Pick a device from the list above to see its input." />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ================= Mappings ================= -->
            <TabItem Header="Mappings">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <WrapPanel>
                            <CheckBox x:Name="MappingsActive" Content="Mappings active" IsChecked="True" Margin="0,0,24,0"
                                      VerticalAlignment="Center" Checked="MappingsActive_Changed" Unchecked="MappingsActive_Changed"
                                      ToolTip="Turn every mapping off (default behavior everywhere) without deleting them" />
                            <Button x:Name="MapLastButton" Content="Map last input" IsEnabled="False" Margin="0,0,24,0"
                                    Click="MapLast_Click"
                                    ToolTip="Press a button or swipe on the device, then click here to create a mapping for it" />
                            <TextBlock Text="or add for" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Secondary}" />
                            <ComboBox x:Name="TriggerPicker" Width="280" DisplayMemberPath="Label" Margin="0,0,8,0"
                                      DropDownOpened="TriggerPicker_DropDownOpened" />
                            <Button Content="Add mapping" Click="AddMapping_Click" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Mappings run in the background, even when this window isn't focused. Scrolling goes to the window under the mouse pointer; keyboard shortcuts go to the focused app. 'Block default' works for keys and media keys (volume, play/pause…); touch is blocked for the whole device below." />

                        <!-- Touch blocking (HidHide) -->
                        <Border x:Name="TouchPanel" CornerRadius="6" Padding="12,10" Margin="0,12,0,0" BorderThickness="1"
                                Visibility="Collapsed"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <Button x:Name="TouchBlockButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Margin="16,0,0,0" Click="TouchBlock_Click" />
                                <StackPanel>
                                    <TextBlock x:Name="TouchTitle" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TouchStatus" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <CheckBox x:Name="ReadTouchBox" Content="Read touch for mappings while blocked" MinWidth="0"
                                              Margin="0,8,0,0" Checked="ReadTouch_Changed" Unchecked="ReadTouch_Changed"
                                              ToolTip="Needed for touch mappings. Untick to block touch without the app reading the ring's touch channel at all." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RuleList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type mapping:MappingRule}">
                                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderThickness="1"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" VerticalAlignment="Center"
                                                          Margin="0,0,12,0" ToolTip="Enable this mapping" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Caption}" Text="WHEN" />
                                                    <TextBlock Text="{Binding TriggerLabel}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TriggerId}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="→" FontSize="20" Margin="12,0"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="3" VerticalAlignment="Center"
                                                          ItemsSource="{x:Static mapping:MappingOptions.Operations}"
                                                          DisplayMemberPath="Name" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Operation}" />

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding IsScroll, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Amount" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBox Width="70" VerticalAlignment="Center"
                                                                 Text="{Binding ScrollAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="notches (1 ≈ 3 lines)" Style="{StaticResource Secondary}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVis}}">
                                                        <CheckBox Content="Ctrl" IsChecked="{Binding Ctrl}" MinWidth="0" Margin="0,0,12,0" />
                                                        <CheckBox Content="Alt" IsChecked="{Binding Alt}" MinWidth="0" Margin="0,0,12,0" />
                                                        <CheckBox Content="Shift" IsChecked="{Binding Shift}" MinWidth="0" Margin="0,0,12,0" />
                                                        <CheckBox Content="Win" IsChecked="{Binding Win}" MinWidth="0" Margin="0,0,12,0" />
                                                        <ComboBox Width="160" ItemsSource="{x:Static mapping:MappingOptions.Keys}"
                                                                  DisplayMemberPath="Name" SelectedValuePath="Vk"
                                                                  SelectedValue="{Binding KeyVk}" />
                                                        <TextBlock Text="{Binding KeyComboText}" Style="{StaticResource Secondary}"
                                                                   FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <CheckBox Grid.Column="5" Content="Block default" MinWidth="0" VerticalAlignment="Center"
                                                          IsChecked="{Binding BlockDefault}" IsEnabled="{Binding CanBlock}"
                                                          ToolTip="{Binding BlockHint}" ToolTipService.ShowOnDisabled="True" />
                                                <Button Grid.Column="6" Content="Remove" Margin="16,0,0,0" VerticalAlignment="Center"
                                                        Click="RemoveMapping_Click" Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="NoRulesHint" Style="{StaticResource Secondary}" FontSize="16" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <TextBlock x:Name="Status" Grid.Row="5" Margin="0,12,0,0" TextWrapping="Wrap"
                   Style="{StaticResource Secondary}"
                   Text="Tip: not sure which entry is the ring? Press one of its buttons — its event counter in the list goes up. Paired Bluetooth devices are listed first." />
    </Grid>
</Window>
